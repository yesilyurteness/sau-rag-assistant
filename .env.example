# Copy to .env and fill in. Never commit .env.

# --- Application
# One of: dev | test | prod
APP_ENV=dev
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:8501"]

# --- Datastores (hostnames match docker-compose service names)
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
REDIS_URL=redis://localhost:6379/0

# --- LLM / embedding providers (only the ones you use are required)
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=
HF_TOKEN=

# --- Observability (Langfuse Cloud free tier recommended for now)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

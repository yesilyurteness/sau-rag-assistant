# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Secrets and local config — never commit these
.env
.env.*
!.env.example

# Data: raw source documents and generated artifacts stay out of git
data/raw/
data/processed/
evals/reports/*.json
!evals/reports/.gitkeep

# OS / editors
.DS_Store
.idea/
.vscode/
